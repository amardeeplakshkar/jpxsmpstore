# ---------------------------------------------------------------
# JPXMC Webstore environment. Copy to .env and fill in real values.
# NEVER commit real credentials.
# ---------------------------------------------------------------

# Core
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://store.example.com

# PostgreSQL (docker-compose service name is "postgres")
DATABASE_URL=postgres://jpxmc:change-me@postgres:5432/jpxmc
POSTGRES_USER=jpxmc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jpxmc

# Redis (docker-compose service name is "redis")
REDIS_URL=redis://redis:6379

# Discord OAuth2 application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect registered in the Discord developer portal
DISCORD_REDIRECT_URI=https://store.example.com/api/auth/discord/callback

# Comma-separated Discord user IDs that are bootstrapped as SUPER_ADMIN on login
ADMIN_DISCORD_IDS=

# Secrets. Generate with: openssl rand -hex 32
SESSION_SECRET=
# 32-byte key as 64 hex chars. Used for AES-256-GCM encryption of IMAP credentials.
ENCRYPTION_KEY=

# IMAP bootstrap values. Copied into the database (encrypted) on first run;
# afterwards manage them in Admin > Settings > Payments.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# UPI bootstrap values (editable later in Admin > Settings > Payments)
UPI_ID=
UPI_PAYEE_NAME=JPXMC

# Storage driver: "local" (private Docker volume) or "cloudinary"
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/app/storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Minecraft server status lookups (host[:port]); can also be set in admin
MINECRAFT_STATUS_API=https://api.mcsrvstat.us/3
